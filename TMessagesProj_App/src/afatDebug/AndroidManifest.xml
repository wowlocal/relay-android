<?xml version="1.0" encoding="utf-8"?>
<!-- Relay debug-only additions (merged on top of TMessagesProj/config/debug/AndroidManifest_SDK23.xml). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/relay_network_security_config">
        <!-- e2e test hooks (org.relaychat.DEBUG_LOGIN / DEBUG_DUMP broadcasts); never in release builds. -->
        <provider
            android:name="org.relaychat.debug.RelayDebugHooks"
            android:authorities="${applicationId}.relaydebug"
            android:exported="false" />
        <!-- A7c test hooks (avatar upload through Telegram's uploader). -->
        <provider
            android:name="org.relaychat.debug.RelayA7cDebugHooks"
            android:authorities="${applicationId}.relaydebuga7c"
            android:exported="false" />
        <!-- A7b e2e hooks: search, members, counters through the client's ConnectionsManager; A7b screens. -->
        <provider
            android:name="org.relaychat.debug.RelayFindingDebugHooks"
            android:authorities="${applicationId}.relaydebug.a7b"
            android:exported="false" />
        <!-- Polish 1 test hooks (forced id renumber, chat dump, keep-alive, logout, profile). -->
        <provider
            android:name="org.relaychat.debug.RelayPolish1DebugHooks"
            android:authorities="${applicationId}.relaydebugpolish1"
            android:exported="false" />
        <!-- A8 test hooks (calls). -->
        <provider
            android:name="org.relaychat.debug.RelayA8DebugHooks"
            android:authorities="${applicationId}.relaydebuga8"
            android:exported="false" />
    </application>
</manifest>
