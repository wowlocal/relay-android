<?xml version="1.0" encoding="utf-8"?>
<!--
  Relay debug builds only. The dev Mattermost server is http://localhost:8065, reached
  from the device through `adb reverse tcp:8065 tcp:8065` (10.0.2.2 = host from the emulator).
  Upstream already sets usesCleartextTraffic="true" (for the in-app browser); a network
  security config replaces that flag, so the base config keeps cleartext allowed as before.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <!-- Debuggable builds also trust user-installed CAs (mitmproxy/Charles for API debugging). -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
